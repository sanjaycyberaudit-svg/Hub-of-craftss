{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hub-catalog",
  "account_id": "542992b23690c0c07bb23e5fecffa6ec",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "SUPABASE_URL": "https://hbazwsedkjgkatkdljtq.supabase.co"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hub-catalog",
      "database_id": "a7c2ace3-a28a-41fb-bd19-e6826e172d03"
    }
  ],
  "triggers": {
    // Safety net if an admin-write sync is missed; unchanged rows cost no writes.
    "crons": ["*/30 * * * *"]
  }
}
